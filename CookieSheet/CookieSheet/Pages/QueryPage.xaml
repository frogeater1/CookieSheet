<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CookieSheet.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CookieSheet"
    xmlns:data="using:CookieSheet.Data"
    xmlns:helpers="using:CookieSheet.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="用户查询" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="按用户汇总订单 · 支持用户搜索与订单统计"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新数据"
                    VerticalAlignment="Center" MinHeight="36" Click="OnRefreshClick"
                    ToolTipService.ToolTip="从服务器刷新数据并显示全部用户" />
        </Grid>

        <!-- Search Section -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="输入QQ号,cn,收货人或下单账号搜索用户" Header="搜索用户" KeyUp="OnSearchBoxKeyUp" />
            <Button VerticalAlignment="Bottom" Height="32" Content="搜索" Click="OnSearchClick" Grid.Column="1" />
        </Grid>

        <!-- Quick Actions / Analysis Tools -->
        <StackPanel Grid.Row="2" Spacing="12" Orientation="Vertical" Margin="0,0,0,24">
            <TextBlock Text="分析工具" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="全部用户" Width="150" Height="60" Click="OnAllClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE71D;" FontSize="20" />
                                <TextBlock Text="全部用户" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="未补邮查询" Width="150" Height="60" Click="OnUnpaidPostageClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE825;" FontSize="20" />
                                <TextBlock Text="未补邮查询" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="满赠查询" Width="150" Height="60" Click="OnGiftCheckClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8F6;" FontSize="20" />
                                <TextBlock Text="满赠查询" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="Set赠查询" Width="150" Height="60" Click="OnSetGiftStatsClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8F6;" FontSize="20" />
                                <TextBlock Text="Set赠查询" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="超限查询" Width="150" Height="60" Click="OnOverLimitCheckClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE71E;" FontSize="20" />
                                <TextBlock Text="超限查询" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="机器人查询" Width="150" Height="60" Click="OnBotCheckClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE99A;" FontSize="20" />
                                <TextBlock Text="机器人查询" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>


                <Button Content="清空数据" Width="150" Height="60" Click="OnClearDataClick" Background="#FFF8D7DA" BorderBrush="#FFF5C6CB" Foreground="#FF721C24">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="20" />
                                <TextBlock Text="清空数据" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="导出Excel" Width="150" Height="60" Click="OnExportExcelClick">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE74E;" FontSize="20" />
                                <TextBlock Text="导出Excel" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Results Section -->
        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResultsTitle" Text="结果展示" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

            <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind Results}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:UserViewModel">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid Opacity="{x:Bind HeaderOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Subtitle}" Foreground="Gray" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TotalAmount}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind OrderCountText}" Foreground="Gray" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <ItemsControl ItemsSource="{x:Bind Orders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,4" Margin="0,0,0,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Opacity="{Binding ItemOpacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Time -->
                                                <TextBlock Text="{Binding FormattedOrderedAt}" VerticalAlignment="Center" Foreground="Gray" />

                                                <!-- Order ID -->
                                                <TextBlock Grid.Column="1" Text="{Binding orderId}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding orderId}" />

                                                <!-- Tag -->
                                                <TextBlock Grid.Column="2" Text="{Binding tag}" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" Margin="8,0" />

                                                <!-- Product Details -->
                                                <TextBlock Grid.Column="3" helpers:ProductRefundText.Items="{Binding ProductRefunds}" VerticalAlignment="Center" Margin="8,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" IsTextSelectionEnabled="True" />

                                                <!-- Price -->
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedPrice}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />

                                                <!-- Postage Button -->
                                                <Button Grid.Column="5" Content="补邮" FontSize="12" Padding="4,2" Height="24"
                                                        Visibility="{Binding PostageButtonVisibility}"
                                                        Click="OnSinglePostageClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander.Content>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="请选择工具或搜索以查看结果。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" />
        </Grid>
    </Grid>
</Page>
