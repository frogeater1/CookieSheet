<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="CookieSheet.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="备份与恢复" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="备份全部用户、订单、退款记录（含待匹配退款和删除标记）及各批次赠品计算选择，保存到当前服务器。仅在点击备份时保存，只保留最后一份成功备份。"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="BackupDetails" Text="正在读取备份信息…" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BackupButton" Content="备份全部数据" Click="OnBackupClick" IsEnabled="False" />
                        <Button x:Name="RestoreButton" Content="恢复最后备份" Click="OnRestoreClick" IsEnabled="False" />
                        <ProgressRing x:Name="BusyIndicator" Width="24" Height="24" IsActive="True" />
                    </StackPanel>
                    <TextBlock Text="恢复将用最后一份备份覆盖当前全部数据，备份后新增或修改的内容将丢失。恢复不会生成新备份。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="StatusMessage" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="清空全部数据" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="清空当前服务器的全部用户、所有批次订单、退款记录（含待匹配退款和删除标记）及赠品计算选择，不受查询条件或批次筛选限制。"
                               TextWrapping="Wrap" />
                    <TextBlock Text="最后一份手动备份会保留，可用于恢复。清空前不会自动备份；需要保存当前数据时，请先点击上方“备份全部数据”。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ClearButton" Content="清空全部数据" Click="OnClearDataClick" IsEnabled="False"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
