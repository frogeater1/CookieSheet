<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CookieSheet.SoldProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CookieSheet">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedProducts" IsSourceGrouped="True" ItemsPath="Items" />
        <Style x:Key="SalesCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="已售出商品" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="按批次分组展示已导入订单 · 各批次内按原售出件数从高到低排序"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新数据" MinHeight="36"
                    VerticalAlignment="Center" Click="OnRefreshClick" />
        </Grid>

        <ContentControl x:Name="FilterPanel" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Header="搜索商品" PlaceholderText="商品名称或型号"
                             MinWidth="0" KeyDown="OnSearchKeyDown" />
                    <Button Grid.Column="1" Content="搜索" MinHeight="32" VerticalAlignment="Bottom" Click="OnSearchClick" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TagFilter" Header="批次" MinWidth="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnFilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SoldProductTagFilter">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox x:Name="IncludeGifts" Grid.Column="1" Content="包含赠品" IsChecked="True" VerticalAlignment="Bottom"
                              Checked="OnGiftsChanged" Unchecked="OnGiftsChanged" />
                    <Button Grid.Column="2" Content="重置" MinHeight="32" VerticalAlignment="Bottom" Click="OnResetClick" />
                </Grid>
            </StackPanel>
        </ContentControl>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="StatusMessage" IsOpen="False" IsClosable="False" Severity="Error" />
            <InfoBar x:Name="UnmatchedMessage" IsOpen="False" IsClosable="False" Severity="Warning" />
        </StackPanel>

        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResultsSummary" Text="正在加载商品…" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer x:Name="ProductsViewport" Grid.Row="1" HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                <Grid MinWidth="800" Width="{x:Bind ProductsViewport.ViewportWidth, Mode=OneWay}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="3*" MinWidth="300" />
                            <ColumnDefinition Width="2*" MinWidth="240" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="批次" Style="{StaticResource SalesCell}" />
                        <TextBlock Grid.Column="1" Text="商品名称" Style="{StaticResource SalesCell}" />
                        <TextBlock Grid.Column="2" Text="型号" Style="{StaticResource SalesCell}" />
                        <TextBlock Grid.Column="3" Text="净售出（件）" Style="{StaticResource SalesCell}" HorizontalAlignment="Right" Margin="8,0,24,0" />
                    </Grid>
                    <ListView x:Name="ProductsList" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch"
                              ItemsSource="{Binding Source={StaticResource GroupedProducts}}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:SoldProductGroup">
                                        <Grid Padding="8,12" Margin="0,8,0,4" ColumnSpacing="16"
                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Label}" IsTextSelectionEnabled="True" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Margin="0,0,16,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SoldProductViewModel">
                                <Grid Padding="0,4" Margin="0,0,0,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="3*" MinWidth="300" />
                                        <ColumnDefinition Width="2*" MinWidth="240" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TagText}" Style="{StaticResource SalesCell}" ToolTipService.ToolTip="{x:Bind TagText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource SalesCell}" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Model}" Style="{StaticResource SalesCell}" ToolTipService.ToolTip="{x:Bind Model}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind NetText}" ToolTipService.ToolTip="{x:Bind NetTooltip}" Style="{StaticResource SalesCell}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" TextTrimming="None" MaxLines="0" FontWeight="SemiBold" Margin="8,0,24,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText" Grid.Row="1" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="LoadingIndicator" Grid.Row="1" IsActive="False" Visibility="Collapsed" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="正在加载商品" />
        </Grid>
    </Grid>
</Page>
