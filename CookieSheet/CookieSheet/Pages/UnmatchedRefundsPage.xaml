<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CookieSheet.UnmatchedRefundsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CookieSheet">
    <Page.Resources>
        <Style x:Key="RefundCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="待匹配退款" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="尚未匹配到订单或商品的退款 · 最新优先"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新数据"
                    VerticalAlignment="Center" MinHeight="36" Click="OnRefreshClick" />
        </Grid>

        <ContentControl x:Name="FilterPanel" Grid.Row="1" HorizontalContentAlignment="Stretch">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Header="搜索退款" MinWidth="0"
                     PlaceholderText="订单号、退款编号、商品名称或型号" KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Content="搜索" VerticalAlignment="Bottom" Click="OnSearchClick" />
            <Button Grid.Column="2" Content="重置" VerticalAlignment="Bottom" Click="OnResetClick" />
        </Grid>
        </ContentControl>

        <InfoBar x:Name="StatusMessage" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Error" />
        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Name="ResultsSummary" Text="正在加载退款…" FontWeight="SemiBold"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SelectAllButton" Content="全选当前结果" Click="OnSelectAllClick" IsEnabled="False" />
                    <Button x:Name="ClearSelectionButton" Content="取消选择" Click="OnClearSelectionClick" IsEnabled="False" />
                    <Button x:Name="DeleteSelectedButton" Content="删除所选" Click="OnDeleteSelectedClick" IsEnabled="False" />
                    <TextBlock x:Name="SelectionText" Text="已选 0 条" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="RefundsViewport" Grid.Row="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Stretch">
                <Grid MinWidth="1240" Width="{x:Bind RefundsViewport.ViewportWidth, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选择" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="1" Text="退款时间" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="2" Text="订单编号" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="3" Text="退款编号" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="4" Text="商品名称" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="5" Text="商品型号" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="6" Text="退款金额" Style="{StaticResource RefundCellStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="未匹配原因" Style="{StaticResource RefundCellStyle}" />
                        <TextBlock Grid.Column="8" Text="操作" Style="{StaticResource RefundCellStyle}" />
                    </Grid>
                    <ListView x:Name="RefundsList" Grid.Row="1" SelectionMode="None" Padding="0"
                              HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UnmatchedRefundViewModel">
                                <Grid Height="36" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind RefundId}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{StaticResource RefundCellStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind FullTimeText}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind OrderId}" Style="{StaticResource RefundCellStyle}" ToolTipService.ToolTip="{x:Bind OrderId}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind RefundId}" Style="{StaticResource RefundCellStyle}" ToolTipService.ToolTip="{x:Bind RefundId}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ProductName}" Style="{StaticResource RefundCellStyle}" ToolTipService.ToolTip="{x:Bind ProductName}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ProductModel}" Style="{StaticResource RefundCellStyle}" ToolTipService.ToolTip="{x:Bind ProductModel}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind AmountText}" Style="{StaticResource RefundCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind Reason}" Style="{StaticResource RefundCellStyle}" ToolTipService.ToolTip="{x:Bind Reason}" />
                                    <Button Grid.Column="8" Content="删除" Tag="{x:Bind}" Click="OnDeleteClick"
                                            MinWidth="60" MinHeight="28" Padding="10,2" Margin="0,2,12,2"
                                            VerticalAlignment="Center" AutomationProperties.Name="删除退款记录" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText" Grid.Row="1" Visibility="Collapsed" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="LoadingIndicator" Grid.Row="1" IsActive="False" Visibility="Collapsed"
                          Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="正在加载退款" />
        </Grid>
    </Grid>
</Page>
