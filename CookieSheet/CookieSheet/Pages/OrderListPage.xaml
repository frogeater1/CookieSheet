<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CookieSheet.OrderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CookieSheet"
    xmlns:helpers="using:CookieSheet.Helpers">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="订单查询" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="每笔订单独立展示 · 时间按电脑本地时区显示"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新数据"
                    VerticalAlignment="Center" MinHeight="36" Click="OnRefreshClick" />
        </Grid>

        <ContentControl x:Name="FilterPanel" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Header="搜索订单" MinWidth="0"
                             PlaceholderText="订单号、CN、QQ、收件人、账号、手机号或商品"
                             KeyDown="OnSearchKeyDown" />
                    <Button Grid.Column="1" Content="搜索" MinHeight="32"
                            VerticalAlignment="Bottom" Click="OnSearchClick" />
                </Grid>

                <Grid x:Name="FilterGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="DateFilters" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker x:Name="StartDatePicker" Header="开始日期" PlaceholderText="不限" MinWidth="0"
                                            HorizontalAlignment="Stretch" DateChanged="OnDateChanged" />
                        <CalendarDatePicker x:Name="EndDatePicker" Grid.Column="1" Header="结束日期（含当天）"
                                            PlaceholderText="不限" MinWidth="0" HorizontalAlignment="Stretch" DateChanged="OnDateChanged" />
                    </Grid>
                    <Grid x:Name="OtherFilters" Grid.Column="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TagFilter" Header="标签" MinWidth="0"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:OrderTagFilter">
                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="RefundFilter" Grid.Column="1" Header="退款状态" SelectedIndex="0" MinWidth="0"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="全部状态" Tag="All" />
                            <ComboBoxItem Content="有退款" Tag="AnyRefund" />
                            <ComboBoxItem Content="含全退商品" Tag="Full" />
                            <ComboBoxItem Content="含部分退款商品" Tag="Partial" />
                            <ComboBoxItem Content="待导入退款明细" Tag="AwaitingDetails" />
                            <ComboBoxItem Content="退款明细有误" Tag="InvalidDetails" />
                            <ComboBoxItem Content="无退款" Tag="None" />
                        </ComboBox>
                        <ComboBox x:Name="SortOrder" Grid.Column="2" Header="时间排序" SelectedIndex="0" MinWidth="0"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="最新优先" />
                            <ComboBoxItem Content="最早优先" />
                        </ComboBox>
                        <Button Grid.Column="3" Content="重置" VerticalAlignment="Bottom" MinHeight="32"
                                Click="OnResetClick" />
                    </Grid>
                </Grid>
            </StackPanel>
        </ContentControl>

        <InfoBar x:Name="StatusMessage" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Error" />

        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResultsSummary" Text="正在加载订单…" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

            <ScrollViewer x:Name="OrdersViewport" Grid.Row="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Stretch">
                <ListView x:Name="OrdersList" SelectionMode="None" MinWidth="1000"
                          Width="{x:Bind OrdersViewport.ViewportWidth, Mode=OneWay}"
                          HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OrderListItemViewModel">
                            <Grid Padding="0,4" Margin="0,0,0,4"
                                  Opacity="{x:Bind ItemOpacity}"
                                  AutomationProperties.HelpText="{x:Bind PostageStatus}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind ShortOrderedAtText}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind OrderedAtText}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind OrderId}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"
                                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind OrderId}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TagText}" VerticalAlignment="Center" Margin="8,0"
                                           TextWrapping="Wrap" TextTrimming="None" IsTextSelectionEnabled="True"
                                           ToolTipService.ToolTip="{x:Bind TagText}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind UserName}" VerticalAlignment="Center" Margin="8,0"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind UserDetails}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind UserQq}" VerticalAlignment="Center" Margin="8,0"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind UserQq}" />
                                <TextBlock Grid.Column="5" helpers:ProductRefundText.Items="{x:Bind ProductRefunds}" VerticalAlignment="Center" Margin="8,0"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Column="6" Text="{x:Bind PriceText}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           HorizontalAlignment="Right" Margin="0,0,16,0" IsTextSelectionEnabled="True" />
                                <Button Grid.Column="7" Content="删除" Tag="{x:Bind OrderId}" Click="OnDeleteOrderClick"
                                        FontSize="12" Padding="4,0" MinHeight="24" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <TextBlock x:Name="EmptyStateText" Grid.Row="1" Visibility="Collapsed" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="LoadingIndicator" Grid.Row="1" IsActive="False" Visibility="Collapsed"
                          Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="正在加载订单" />
        </Grid>
    </Grid>
</Page>
