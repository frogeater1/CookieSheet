<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CookieSheet.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25">
            <FontIcon Glyph="&#xE8F4;" FontSize="64" />
            <TextBlock Text="数据导入" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="请选择要导入Excel文件,文件名表示批次。" HorizontalAlignment="Center" Foreground="Gray" />

            <Button Content="选择Excel文件" Click="OnImportClick" HorizontalAlignment="Center" Width="200" Height="40" />

            <TextBlock x:Name="StatusTextBlock" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Page>